Options -MultiViews
RewriteEngine On

# Keep sitemap dynamic on shared hosting. Next static export may generate a
# sitemap.xml file, so route requests to the PHP proxy before file checks.
RewriteRule ^sitemap\.xml$ /sitemap.php [L]

# Static shared hosting fallback for live blog/job detail pages.
# Existing exported files/directories keep working; unknown slugs render the
# client-side live page, which fetches fresh content from the API.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^jobs/(.+)/?$ /jobs/live/ [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/(.+)/?$ /blog/live/ [L]
