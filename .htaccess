Options -MultiViews
ErrorDocument 404 /404.html

RewriteEngine On

# Retired jobs pages have no replacement; report them as permanently gone.
RewriteRule ^jobs(?:/.*)?$ - [G,L,NC]

# Use one canonical host so Google does not see www and non-www as duplicates.
RewriteCond %{HTTP_HOST} ^resumesathi\.com$ [NC]
RewriteRule ^ https://www.resumesathi.com%{REQUEST_URI} [R=301,L]

# Canonicalize page URLs to slash format: /about/ not /about
# Do not redirect files, API paths, or already-canonical URLs.
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} !/$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !^/api/ [NC]
RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{2,5}($|/) [NC]
RewriteRule ^(.+?)/?$ /$1/ [R=301,L]

# Replace query-string typing lesson URLs with clean canonical lesson URLs.
RewriteCond %{QUERY_STRING} ^id=(home-row|top-row|bottom-row|numbers|punctuation|capitals|common-words|combined)$ [NC]
RewriteRule ^(?:typing/learn/lesson|tools/typing/learn/lesson)/?$ /tools/typing/learn/lesson/%1/? [R=301,L]

# SearchAction placeholder URLs are templates, not real searchable pages.
RewriteCond %{QUERY_STRING} (^|&)(q|search)=(%7B|\{)?search_term_string(%7D|\})?(&|$) [NC]
RewriteRule ^blog/?$ /blog/? [R=301,L]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 3 hours"
  ExpiresByType text/css "access plus 3 hours"
  ExpiresByType text/javascript "access plus 3 hours"
  ExpiresByType application/javascript "access plus 3 hours"
  ExpiresByType application/json "access plus 3 hours"
  ExpiresByType image/webp "access plus 3 hours"
  ExpiresByType video/webm "access plus 3 hours"
  ExpiresByType image/svg+xml "access plus 3 hours"
  ExpiresByType image/png "access plus 3 hours"
  ExpiresByType image/jpeg "access plus 3 hours"
  ExpiresByType image/jpg "access plus 3 hours"
  ExpiresByType image/x-icon "access plus 3 hours"
  ExpiresByType font/woff2 "access plus 3 hours"
  ExpiresByType font/woff "access plus 3 hours"
  ExpiresByType font/ttf "access plus 3 hours"
  ExpiresByType application/font-woff2 "access plus 3 hours"
  ExpiresByType application/font-woff "access plus 3 hours"
  ExpiresByType application/font-sfnt "access plus 3 hours"
</IfModule>

<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/_next/static/.*$" is_next_static
  SetEnvIf Request_URI "^/front-assets/.*$" is_front_assets
  SetEnvIf Request_URI "^/front-assets/images/job-hero\.webp$" is_jobs_hero
  SetEnvIf Request_URI "^/api-config\.js$" is_api_config
  SetEnvIf Request_URI "^/templates/?$" is_templates_page

  Header set Cache-Control "no-cache, must-revalidate"
  Header set Cache-Control "public, max-age=10800" env=is_next_static
  Header set Cache-Control "public, max-age=10800" env=is_front_assets
  Header set Cache-Control "no-cache, must-revalidate" env=is_jobs_hero
  Header set Cache-Control "public, max-age=10800" env=is_api_config
  Header unset X-Robots-Tag env=is_templates_page
  Header set X-Robots-Tag "index, follow" env=is_templates_page
</IfModule>

# Mark unknown paths as gone while allowing every exported file and directory.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=410,L]
