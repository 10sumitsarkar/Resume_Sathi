ErrorDocument 404 /404/

RewriteEngine On

# Use one canonical host so Google does not see www and non-www as duplicates.
RewriteCond %{HTTP_HOST} ^resumesathi\.com$ [NC]
RewriteRule ^ https://www.resumesathi.com%{REQUEST_URI} [R=301,L]

# Replace query-string typing lesson URLs with clean canonical lesson URLs.
RewriteCond %{QUERY_STRING} ^id=(home-row|top-row|bottom-row|numbers|punctuation|capitals|common-words|combined)$ [NC]
RewriteRule ^typing/learn/lesson/?$ /typing/learn/lesson/%1/? [R=301,L]

# SearchAction placeholder URLs are templates, not real searchable pages.
RewriteCond %{QUERY_STRING} (^|&)(q|search)=(%7B|\{)?search_term_string(%7D|\})?(&|$) [NC]
RewriteRule ^blog/?$ /blog/? [R=301,L]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 30 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType application/json "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/jpg "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 365 days"
  ExpiresByType font/woff "access plus 365 days"
  ExpiresByType font/ttf "access plus 365 days"
  ExpiresByType application/font-woff2 "access plus 365 days"
  ExpiresByType application/font-woff "access plus 365 days"
  ExpiresByType application/font-sfnt "access plus 365 days"
</IfModule>

<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/_next/static/.*$" is_next_static
  SetEnvIf Request_URI "^/front-assets/.*$" is_front_assets
  SetEnvIf Request_URI "^/front-assets/images/job-hero\.webp$" is_jobs_hero
  SetEnvIf Request_URI "^/api-config\.js$" is_api_config
  SetEnvIf Request_URI "^/templates/?$" is_templates_page

  Header set Cache-Control "public, max-age=31536000, immutable" env=is_next_static
  Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=604800" env=is_front_assets
  Header set Cache-Control "no-cache, must-revalidate" env=is_jobs_hero
  Header set Cache-Control "public, max-age=604800, stale-while-revalidate=604800" env=is_api_config
  Header unset X-Robots-Tag env=is_templates_page
  Header set X-Robots-Tag "index, follow" env=is_templates_page
</IfModule>
