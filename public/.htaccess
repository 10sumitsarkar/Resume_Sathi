Options -MultiViews
ErrorDocument 404 /404.html
RewriteEngine On

# Use one canonical host so Google does not see www and non-www as duplicates.
RewriteCond %{HTTP_HOST} ^resumesathi\.com$ [NC]
RewriteRule ^ https://www.resumesathi.com%{REQUEST_URI} [R=301,L]

# Replace query-string typing lesson URLs with clean canonical lesson URLs.
RewriteCond %{QUERY_STRING} ^id=(home-row|top-row|bottom-row|numbers|punctuation|capitals|common-words|combined)$ [NC]
RewriteRule ^typing/learn/lesson/?$ /typing/learn/lesson/%1/? [R=301,L]

# SearchAction placeholder URLs are templates, not real searchable pages.
RewriteCond %{QUERY_STRING} (^|&)(q|search)=(%7B|\{)?search_term_string(%7D|\})?(&|$) [NC]
RewriteRule ^blog/?$ /blog/? [R=301,L]

# Keep sitemap dynamic on shared hosting. Next static export may generate a
# sitemap.xml file, so route requests to the PHP proxy before file checks.
RewriteRule ^sitemap\.xml$ /sitemap.php [L]

# Legacy job category query URLs -> clean static category pages.
RewriteCond %{QUERY_STRING} (^|&)category_id=9(&|$) [NC]
RewriteRule ^jobs/?$ /jobs/railway/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)category_id=10(&|$) [NC]
RewriteRule ^jobs/?$ /jobs/state-psc/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)category_id=11(&|$) [NC]
RewriteRule ^jobs/?$ /jobs/judiciary/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)category_id=12(&|$) [NC]
RewriteRule ^jobs/?$ /jobs/defence/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)category_id=13(&|$) [NC]
RewriteRule ^jobs/?$ /jobs/psu/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)category_id=14(&|$) [NC]
RewriteRule ^jobs/?$ /jobs/university/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)category_id=15(&|$) [NC]
RewriteRule ^jobs/?$ /jobs/teaching/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)category_id=16(&|$) [NC]
RewriteRule ^jobs/?$ /jobs/banking/? [R=301,L]

# Legacy category suffix URLs -> clean canonical category URLs.
RewriteRule ^jobs/railway-jobs/?$ /jobs/railway/ [R=301,L]
RewriteRule ^jobs/banking-jobs/?$ /jobs/banking/ [R=301,L]
RewriteRule ^jobs/state-psc-jobs/?$ /jobs/state-psc/ [R=301,L]
RewriteRule ^jobs/judiciary-jobs/?$ /jobs/judiciary/ [R=301,L]
RewriteRule ^jobs/defence-jobs/?$ /jobs/defence/ [R=301,L]
RewriteRule ^jobs/psu-jobs/?$ /jobs/psu/ [R=301,L]
RewriteRule ^jobs/university-jobs/?$ /jobs/university/ [R=301,L]
RewriteRule ^jobs/teaching-jobs/?$ /jobs/teaching/ [R=301,L]

